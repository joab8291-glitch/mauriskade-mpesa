{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.mauriskade.co.ke/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/copyright",
      "destination": "/copyright.html"
    }
  ]
}
