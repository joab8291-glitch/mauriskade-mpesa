PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/hydro_pay

# Hydro IoT meter API (server-side only, never expose this to the browser)
HYDRO_BASE_URL=http://8.217.30.113:8027/api1
HYDRO_TOKEN=put_the_REISSUED_token_here
HYDRO_COMPANY_ID=10185

# Shown on the pages and used for the m3 estimate (the dashboard says: Fixed Price, 120 KSh per cubic meter)
BUSINESS_NAME=Mauriskade Apartments
PRICE_PER_M3=120

# Daraja (Mauriskade's Paybill)
MPESA_ENV=sandbox                      # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TXN_TYPE=CustomerPayBillOnline   # use CustomerBuyGoodsOnline only if it is a Till
# Till number to receive the money. Only for CustomerBuyGoodsOnline, where MPESA_SHORTCODE is the
# store/head-office number used for the password. Leave empty for a Paybill.
MPESA_PARTYB=

# Public HTTPS URL of THIS backend, and a long random string for the callback path
CALLBACK_BASE_URL=https://your-backend.example.com
CALLBACK_SECRET=generate_a_long_random_string

# Limits (KES, whole shillings)
MIN_AMOUNT=60
MAX_AMOUNT=20000

# Opens /admin. At least 12 characters (20+ recommended), for example: openssl rand -base64 32
# Leave empty to switch the admin panel off (then nobody can get logins).
ADMIN_KEY=

# How long a customer stays signed in
SESSION_DAYS=7

# Optional. Management contact shown on the Privacy, Terms and Copyright pages.
# Leave empty and those pages say "the Mauriskade Apartments management office".
CONTACT_EMAIL=
CONTACT_PHONE=

# Manual STS recharge in the admin panel issues a token with NO payment. Off unless set to true.
ADMIN_RECHARGE_ENABLED=false

# Shared C2B gateway secret: must match Webazi Daraja service's MAURISKADE_C2B_SECRET
MAURISKADE_C2B_SECRET=replace_with_the_same_long_random_secret_as_webazi

# Optional rent collection reminders and approved tenant notices.
# A webhook adapter must send the supplied channel/to/message and return { messageId: "provider-id" }.
# Delivery callbacks POST to CALLBACK_BASE_URL/api/rent/notifications/delivery with
# X-Notification-Secret: RENT_NOTIFICATION_WEBHOOK_SECRET and { providerReference, status }.
RENT_NOTIFICATION_WEBHOOK_URL=
RENT_NOTIFICATION_WEBHOOK_SECRET=generate_a_long_random_secret
RENT_NOTIFICATION_CHANNELS=sms             # sms,whatsapp,email (comma-separated)

# Encrypted daily database backup to a PRIVATE Supabase Storage bucket.
# Keep the service-role key server-side in Render only; never expose it to browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server_side_service_role_key
RENT_BACKUP_STORAGE_BUCKET=mauriskade-db-backups
RENT_BACKUP_ENCRYPTION_KEY=generate_a_separate_32_plus_character_secret
RENT_BACKUP_RETENTION_DAYS=90
# Daily run after this hour in Africa/Nairobi (EAT).
RENT_BACKUP_HOUR=2
