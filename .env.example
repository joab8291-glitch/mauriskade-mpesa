PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/hydro_pay

# Hydro IoT meter API (server-side only, never expose this to the browser)
HYDRO_BASE_URL=http://8.217.30.113:8027/api1
HYDRO_TOKEN=put_the_REISSUED_token_here
HYDRO_COMPANY_ID=10185

# Shown on the pages and used for the m3 estimate (the dashboard says: Fixed Price, 120 KSh per cubic meter)
BUSINESS_NAME=Mauriskade Apartments
PRICE_PER_M3=120

# Daraja (Mauriskade's Paybill)
MPESA_ENV=sandbox                      # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TXN_TYPE=CustomerPayBillOnline   # use CustomerBuyGoodsOnline only if it is a Till

# Public HTTPS URL of THIS backend, and a long random string for the callback path
CALLBACK_BASE_URL=https://your-backend.example.com
CALLBACK_SECRET=generate_a_long_random_string

# Limits (KES, whole shillings)
MIN_AMOUNT=10
MAX_AMOUNT=20000

# Opens /admin. At least 20 characters, for example: openssl rand -base64 32
# Leave empty to switch the admin panel off (then nobody can get logins).
ADMIN_KEY=

# How long a customer stays signed in
SESSION_DAYS=7
