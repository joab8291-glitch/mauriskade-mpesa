PORT=3000
# Supabase Dashboard > Project > Connect > Session pooler (port 5432).
# Use the URI format and replace the password locally in Render Environment settings.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require

# Hydro IoT meter API (server-side only, never expose this to the browser)
HYDRO_BASE_URL=http://8.217.30.113:8027/api1
HYDRO_TOKEN=
HYDRO_COMPANY_ID=10185

BUSINESS_NAME=Mauriskade Apartments
PRICE_PER_M3=120

# Daraja credentials (server-side only)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TXN_TYPE=CustomerPayBillOnline

# Set CALLBACK_BASE_URL to https://mauriskade-mpesa-api.onrender.com
CALLBACK_BASE_URL=https://mauriskade-mpesa-api.onrender.com
CALLBACK_SECRET=

MIN_AMOUNT=10
MAX_AMOUNT=20000
